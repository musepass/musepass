# Copy to contracts/.env before running a deploy script. Never commit it.
#
# Deployer key: a throwaway key used only to send this one deployment
# transaction. It must NOT be the key that owns the root name.
MUSENAME_DEPLOYER_KEY=

# Durin L2 registry on the target chain (from durin.dev).
MUSENAME_L2_REGISTRY=

# From config/brand.json "productName" — becomes the EIP-712 domain name.
MUSENAME_BRAND_NAME=MuseName

# From config/limits.json "minLabelUnitsPremium" converted to utf-8 bytes.
MUSENAME_MIN_LABEL_BYTES=3

# Multisig or hardware wallet that administers the registrar from now on.
MUSENAME_REGISTRAR_OWNER=
