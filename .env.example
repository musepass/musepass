# ---------------------------------------------------------------------------
# MuseName environment template. Copy to .env and fill in. Never commit .env.
# Every value here is read through config/ + packages/core/src/config.ts.
# ---------------------------------------------------------------------------

# --- Brand (rule 6: brand strings are config, never hardcoded) --------------
MUSENAME_BRAND=                      # optional override of config/brand.json productName

# --- Chain endpoints -------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Deployed addresses (filled in after phase 1 deployment) ---------------
MUSENAME_L2_REGISTRY=                # Durin L2Registry on Base
MUSENAME_REGISTRAR=                  # MuseNameRegistrar on Base
MUSENAME_L1_RESOLVER=                # Durin L1Resolver (mainnet ENS resolver)

# --- Signing keys: keep SEPARATED (rule: platform key != sponsoring key) ---
MUSENAME_CARD_SIGNER_KEY=            # signs cards / claim intents (EIP-712)
MUSENAME_ISSUER_KEY=                 # submits registration txs (sponsors gas)
# Never put the root name owner key here. The root .eth name lives in a
# hardware wallet or multisig and must not exist on any server.

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/musename

# --- Gateway ---------------------------------------------------------------
GATEWAY_PORT=8787
GATEWAY_UPSTREAM_RPC_BASE=https://mainnet.base.org

# --- IPFS (phase 2) --------------------------------------------------------
IPFS_API_URL=
IPFS_API_TOKEN=
